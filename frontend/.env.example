# =============================================================================
# Frontend environment template — copy to frontend/.env and fill in real values.
# All variables exposed to the browser MUST be prefixed with VITE_.
# NEVER put secrets here — anything in VITE_* is publicly readable in the bundle.
# =============================================================================

# Backend Spring Boot URL (used by the Axios client in dev).
# In production, set this to your deployed backend URL.
VITE_API_BASE_URL=http://localhost:8080

# Where Vite proxies /api/* during development. Should match backend port.
VITE_API_PROXY_TARGET=http://localhost:8080

# Google Maps browser API key (used by @googlemaps/js-api-loader / Vue Google Maps).
# Get a key from https://console.cloud.google.com/google/maps-apis/credentials
# Restrict it by HTTP referrer (your dev + prod domains).
VITE_GOOGLE_MAPS_API_KEY=

# Internal API key sent as X-API-Key. Must match backend APP_API_KEY.
# DO NOT use a high-trust key here — restrict the Maps key by referrer instead.
VITE_APP_API_KEY=dev-secret-change-me