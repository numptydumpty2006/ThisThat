# =============================================================================
# Root .gitignore — applies to both backend/ and frontend/ at the repo root.
# =============================================================================

# --- Secrets & env files (NEVER commit these) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo

# ============================================================================
# Backend (Java / Maven / Spring Boot)
# ============================================================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

backend/.apt_generated
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings
backend/.springBeans
backend/.sts4-cache

backend/HELP.md

# ============================================================================
# Frontend (Node / Vite / Vue)
# ============================================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/coverage/

# IDE-specific Vue files
*.iml