# =============================================================================
# Backend environment template — copy to backend/.env and fill in real values.
# NEVER commit the real .env to git. The .gitignore already excludes it.
# =============================================================================

# --- Spring profile & HTTP ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL (matches docker-compose.yml defaults) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/cafe_finder
DATABASE_USERNAME=cafe_user
DATABASE_PASSWORD=cafe_password
# 'validate' = trust Flyway migrations; 'update' = Hibernate auto-DDL (dev only)
JPA_DDL_AUTO=validate

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Google Places API (REQUIRED in prod; leave blank in dev for mock mode) ---
# Get a key from https://console.cloud.google.com/google/maps-apis/credentials
# Restrict it to "Places API" + your dev IP for safety.
GOOGLE_PLACES_API_KEY=

# --- Internal API key (clients must send this as X-API-Key) ---
# Generate with: openssl rand -hex 32
APP_API_KEY=dev-secret-change-me

# --- Rate limiting (requests per minute per client) ---
RATE_LIMIT_RPM=60