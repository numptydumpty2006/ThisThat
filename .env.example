# Copy this file to .env at the repo root.
# docker compose reads these values automatically.

# --- PostgreSQL ---
POSTGRES_DB=cafe_finder
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=cafe_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend / Frontend shared ---
# Shared in backend/.env too; keep them in sync.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080